# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# Ignore database schemas, migrations, and markdown notes
*.sql
!supabase/migrations/**
*.md
!README.md
!docs/**
# Konten Modul Belajar (Fase 24): berkas Markdown yang ditinjau lewat diff
!content/**

# next process runner temp files
.next-start.*
# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
